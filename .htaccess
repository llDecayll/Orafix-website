<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. Redirect /index.html and /index to root /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index(?:\.html)?[\s?] [NC]
RewriteRule ^index(?:\.html)?$ / [R=301,L]

# 2. Redirect /page.html to /page (removes .html from URL in browser)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# 3. Internally rewrite /page to /page.html if the .html file exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
